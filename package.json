{
    "name": "dsh-vsc-integration",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "0.10.0",
    "publisher": "harcochen",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/HarcoChen/dsh-vsc-integration.git"
    },
    "bugs": {
        "url": "https://github.com/HarcoChen/dsh-vsc-integration/issues"
    },
    "homepage": "https://github.com/HarcoChen/dsh-vsc-integration#readme",
    "icon": "resources/dsh.png",
    "galleryBanner": {
        "color": "#0F172A",
        "theme": "dark"
    },
    "l10n": "./l10n",
    "engines": {
        "vscode": "^1.106.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": false,
        "untrustedWorkspaces": {
            "supported": false,
            "description": "%extension.untrustedWorkspace%"
        }
    },
    "categories": [
        "Chat",
        "Machine Learning"
    ],
    "keywords": [
        "DeepSeek",
        "DeepSeek Harness",
        "dsh",
        "AI",
        "coding agent",
        "AI assistant",
        "code review",
        "diff",
        "debugging",
        "chat"
    ],
    "main": "./dist/extension.js",
    "types": "./dist/extension.d.ts",
    "chatParticipants": [
        {
            "id": "dsh",
            "name": "DSH",
            "description": "Send a task to the DeepSeek Harness session"
        }
    ],
    "activationEvents": [
        "onStartupFinished",
        "onView:dsh.chatView",
        "onCommand:dsh.open",
        "onCommand:dsh.openInEditor",
        "onCommand:dsh.openTrace",
        "onWebviewPanel:dsh.traceEditor",
        "onCommand:dsh.newSession",
        "onCommand:dsh.switchSession",
        "onCommand:dsh.searchSession",
        "onCommand:dsh.selectModel",
        "onCommand:dsh.renameSession",
        "onCommand:dsh.forkSession",
        "onCommand:dsh.archiveSession",
        "onCommand:dsh.start",
        "onCommand:dsh.stop",
        "onCommand:dsh.restart",
        "onCommand:dsh.insertEditorReference",
        "onCommand:dsh.askAboutResource",
        "onCommand:dsh.explainDebugState",
        "onCommand:dsh.editorTask.explain",
        "onCommand:dsh.editorTask.fix",
        "onCommand:dsh.editorTask.review",
        "onCommand:dsh.editorTask.docs",
        "onCommand:dsh.gitDiffTask.explain",
        "onCommand:dsh.gitDiffTask.fix",
        "onCommand:dsh.gitDiffTask.review",
        "onCommand:dsh.gitDiffTask.docs",
        "onCommand:dsh.openIdeContextPicker",
        "onCommand:dsh.captureAppShot",
        "onCommand:dsh.configureApiKey",
        "onCommand:dsh.configureJevApiKey",
        "onCommand:dsh.manageProviders",
        "onCommand:dsh.manageWorkspaces",
        "onCommand:dsh.manageAgentPresets",
        "onCommand:dsh.refreshBalance",
        "onCommand:dsh.diagnoseEnvironment",
        "onCommand:dsh.openLogs",
        "onCommand:dsh.openInBrowser",
        "onCommand:dsh.recovery.cancel",
        "onCommand:dsh.recovery.openDiagnostics",
        "onCommand:dsh.recovery.exportDiagnostics",
        "onCommand:dsh.recovery.restore"
    ],
    "contributes": {
        "chatParticipants": [
            {
                "id": "dsh",
                "name": "dsh",
                "fullName": "DeepSeek Harness",
                "description": "%chatParticipant.description%",
                "isSticky": true
            }
        ],
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "dsh",
                    "title": "DSH",
                    "icon": "resources/dsh.svg"
                }
            ]
        },
        "views": {
            "dsh": [
                {
                    "type": "webview",
                    "id": "dsh.chatView",
                    "name": "%view.chat.name%",
                    "icon": "resources/dsh.svg",
                    "visibility": "visible"
                },
                {
                    "type": "tree",
                    "id": "dsh.conversationNavigation",
                    "name": "%view.conversationNavigation.name%",
                    "icon": "$(list-tree)",
                    "visibility": "collapsed"
                }
            ]
        },
        "commands": [
            {
                "command": "dsh.open",
                "title": "%command.open.title%",
                "category": "DSH",
                "icon": {
                    "light": "resources/dsh.svg",
                    "dark": "resources/dsh-dark.svg"
                }
            },
            {
                "command": "dsh.openInEditor",
                "title": "%command.openInEditor.title%",
                "category": "DSH",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "dsh.openTrace",
                "title": "%command.openTrace.title%",
                "category": "DSH",
                "icon": "$(pulse)"
            },
            {
                "command": "dsh.newSession",
                "title": "%command.newSession.title%",
                "category": "DSH",
                "icon": "$(add)"
            },
            {
                "command": "dsh.switchSession",
                "title": "%command.switchSession.title%",
                "category": "DSH",
                "icon": "$(list-selection)"
            },
            {
                "command": "dsh.searchSession",
                "title": "%command.searchSession.title%",
                "category": "DSH",
                "icon": "$(search)"
            },
            {
                "command": "dsh.selectModel",
                "title": "%command.selectModel.title%",
                "category": "DSH",
                "icon": "$(symbol-misc)"
            },
            {
                "command": "dsh.renameSession",
                "title": "%command.renameSession.title%",
                "category": "DSH",
                "icon": "$(edit)"
            },
            {
                "command": "dsh.forkSession",
                "title": "%command.forkSession.title%",
                "category": "DSH",
                "icon": "$(repo-forked)"
            },
            {
                "command": "dsh.archiveSession",
                "title": "%command.archiveSession.title%",
                "category": "DSH",
                "icon": "$(archive)"
            },
            {
                "command": "dsh.start",
                "title": "%command.start.title%",
                "category": "DSH",
                "icon": "$(play)"
            },
            {
                "command": "dsh.stop",
                "title": "%command.stop.title%",
                "category": "DSH",
                "icon": "$(debug-stop)"
            },
            {
                "command": "dsh.restart",
                "title": "%command.restart.title%",
                "category": "DSH",
                "icon": "$(refresh)"
            },
            {
                "command": "dsh.openLogs",
                "title": "%command.openLogs.title%",
                "category": "DSH",
                "icon": "$(output)"
            },
            {
                "command": "dsh.recovery.cancel",
                "title": "%command.recovery.cancel.title%",
                "category": "DSH",
                "icon": "$(debug-stop)"
            },
            {
                "command": "dsh.recovery.openDiagnostics",
                "title": "%command.recovery.openDiagnostics.title%",
                "category": "DSH",
                "icon": "$(output)"
            },
            {
                "command": "dsh.recovery.exportDiagnostics",
                "title": "%command.recovery.exportDiagnostics.title%",
                "category": "DSH",
                "icon": "$(export)"
            },
            {
                "command": "dsh.recovery.restore",
                "title": "%command.recovery.restore.title%",
                "category": "DSH",
                "icon": "$(discard)"
            },
            {
                "command": "dsh.openInBrowser",
                "title": "%command.openInBrowser.title%",
                "category": "DSH",
                "icon": "$(globe)"
            },
            {
                "command": "dsh.insertEditorReference",
                "title": "%command.insertEditorReference.title%",
                "category": "DSH",
                "icon": "$(references)"
            },
            {
                "command": "dsh.askAboutResource",
                "title": "%command.askAboutResource.title%",
                "category": "DSH",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "dsh.explainDebugState",
                "title": "%command.explainDebugState.title%",
                "category": "DSH",
                "icon": {
                    "light": "resources/dsh.svg",
                    "dark": "resources/dsh-dark.svg"
                }
            },
            {
                "command": "dsh.editorTask.explain",
                "title": "%dsh.editorTask.explain.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.editorTask.fix",
                "title": "%dsh.editorTask.fix.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.editorTask.review",
                "title": "%dsh.editorTask.review.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.editorTask.docs",
                "title": "%dsh.editorTask.docs.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.explain",
                "title": "%dsh.gitDiffTask.explain.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.fix",
                "title": "%dsh.gitDiffTask.fix.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.review",
                "title": "%dsh.gitDiffTask.review.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.gitDiffTask.docs",
                "title": "%dsh.gitDiffTask.docs.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.openIdeContextPicker",
                "title": "%command.openIdeContextPicker.title%",
                "category": "DSH",
                "icon": "$(settings)"
            },
            {
                "command": "dsh.insertPromptTemplate",
                "title": "%command.insertPromptTemplate.title%",
                "category": "DSH"
            },
            {
                "command": "dsh.captureAppShot",
                "title": "%command.captureAppShot.title%",
                "category": "DSH",
                "icon": "$(device-camera)"
            },
            {
                "command": "dsh.configureApiKey",
                "title": "%command.configureApiKey.title%",
                "category": "DSH",
                "icon": "$(key)"
            },
            {
                "command": "dsh.configureJevApiKey",
                "title": "%command.configureJevApiKey.title%",
                "category": "DSH",
                "icon": "$(key)"
            },
            {
                "command": "dsh.manageProviders",
                "title": "%command.manageProviders.title%",
                "category": "DSH",
                "icon": "$(server-environment)"
            },
            {
                "command": "dsh.manageWorkspaces",
                "title": "%command.manageWorkspaces.title%",
                "category": "DSH",
                "icon": "$(folder-library)"
            },
            {
                "command": "dsh.manageAgentPresets",
                "title": "%command.manageAgentPresets.title%",
                "category": "DSH",
                "icon": "$(symbol-misc)"
            },
            {
                "command": "dsh.refreshBalance",
                "title": "%command.refreshBalance.title%",
                "category": "DSH",
                "icon": "$(dashboard)"
            },
            {
                "command": "dsh.diagnoseEnvironment",
                "title": "%command.diagnoseEnvironment.title%",
                "category": "DSH",
                "icon": "$(tools)"
            },
            {
                "command": "dsh.revealConversationMilestone",
                "title": "%command.revealConversationMilestone.title%",
                "category": "DSH"
            }
        ],
        "submenus": [
            {
                "id": "dsh.editorTasks",
                "label": "%dsh.editorTasks.label%"
            },
            {
                "id": "dsh.gitDiffTasks",
                "label": "%dsh.gitDiffTasks.label%"
            }
        ],
        "keybindings": [
            {
                "command": "dsh.open",
                "key": "ctrl+shift+alt+d",
                "mac": "cmd+shift+alt+d"
            },
            {
                "command": "dsh.insertEditorReference",
                "key": "alt+k",
                "mac": "alt+k",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "dsh.revealConversationMilestone",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "dsh.open",
                    "group": "navigation@dsh"
                }
            ],
            "editor/context": [
                {
                    "submenu": "dsh.editorTasks",
                    "group": "navigation@dsh"
                }
            ],
            "explorer/context": [
                {
                    "command": "dsh.askAboutResource",
                    "group": "navigation@dsh"
                }
            ],
            "debug/toolBar": [
                {
                    "command": "dsh.explainDebugState",
                    "when": "debugState == 'stopped'",
                    "group": "navigation@dsh"
                }
            ],
            "dsh.editorTasks": [
                {
                    "command": "dsh.editorTask.explain",
                    "group": "1_tasks@1"
                },
                {
                    "command": "dsh.editorTask.fix",
                    "group": "1_tasks@2"
                },
                {
                    "command": "dsh.editorTask.review",
                    "group": "1_tasks@3"
                },
                {
                    "command": "dsh.editorTask.docs",
                    "group": "1_tasks@4"
                }
            ],
            "scm/resourceGroup/context": [
                {
                    "submenu": "dsh.gitDiffTasks",
                    "when": "scmProvider == git",
                    "group": "navigation@dsh"
                }
            ],
            "dsh.gitDiffTasks": [
                {
                    "command": "dsh.gitDiffTask.explain",
                    "group": "1_tasks@1"
                },
                {
                    "command": "dsh.gitDiffTask.fix",
                    "group": "1_tasks@2"
                },
                {
                    "command": "dsh.gitDiffTask.review",
                    "group": "1_tasks@3"
                },
                {
                    "command": "dsh.gitDiffTask.docs",
                    "group": "1_tasks@4"
                }
            ],
            "view/title": [
                {
                    "command": "dsh.newSession",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh0"
                },
                {
                    "command": "dsh.openInBrowser",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh1"
                },
                {
                    "command": "dsh.openInEditor",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh2"
                },
                {
                    "command": "dsh.openTrace",
                    "when": "view == dsh.chatView",
                    "group": "1_dsh@1"
                },
                {
                    "command": "dsh.openLogs",
                    "when": "view == dsh.chatView",
                    "group": "1_dsh@2"
                },
                {
                    "command": "dsh.restart",
                    "when": "view == dsh.chatView",
                    "group": "1_dsh@3"
                },
                {
                    "command": "dsh.configureJevApiKey",
                    "when": "view == dsh.chatView",
                    "group": "1_dsh@4"
                }
            ]
        },
        "configuration": {
            "title": "DSH IDE",
            "properties": {
                "dsh.command": {
                    "type": "string",
                    "default": "auto",
                    "description": "%config.command.description%"
                },
                "dsh.commandArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "web",
                        "--no-open"
                    ],
                    "description": "%config.commandArgs.description%"
                },
                "dsh.npxTimeoutMs": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 10000,
                    "maximum": 600000,
                    "description": "%config.npxTimeoutMs.description%"
                },
                "dsh.npmRegistry": {
                    "type": "string",
                    "default": "https://registry.npmmirror.com",
                    "description": "%config.npmRegistry.description%"
                },
                "dsh.enableCompaction": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableCompaction.description%"
                },
                "dsh.jev.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.jev.enabled.description%"
                },
                "dsh.jev.baseUrl": {
                    "type": "string",
                    "default": "https://api.typesafe.ai/v1/systemone",
                    "description": "%config.jev.baseUrl.description%"
                },
                "dsh.jev.model": {
                    "type": "string",
                    "default": "jev-latest",
                    "description": "%config.jev.model.description%"
                },
                "dsh.jev.timeoutMs": {
                    "type": "number",
                    "default": 2000,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.timeoutMs.description%"
                },
                "dsh.jev.advisoryTimeoutMs": {
                    "type": "number",
                    "default": 3500,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.advisoryTimeoutMs.description%"
                },
                "dsh.jev.askThreshold": {
                    "type": "number",
                    "default": 0.5,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%config.jev.askThreshold.description%"
                },
                "dsh.jev.blockThreshold": {
                    "type": "number",
                    "default": 0.85,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%config.jev.blockThreshold.description%"
                },
                "dsh.jev.guardedTools": {
                    "type": "array",
                    "default": [
                        "bash",
                        "pwsh",
                        "terminal",
                        "run_command",
                        "execute_command",
                        "run_code",
                        "write_to_file",
                        "replace_file_content"
                    ],
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": "%config.jev.guardedTools.description%"
                },
                "dsh.jev.loopGuard.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.jev.loopGuard.enabled.description%"
                },
                "dsh.jev.loopGuard.triggerThreshold": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 120,
                    "description": "%config.jev.loopGuard.triggerThreshold.description%"
                },
                "dsh.jev.loopGuard.noProgressThreshold": {
                    "type": "number",
                    "default": 0.3,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%config.jev.loopGuard.noProgressThreshold.description%"
                },
                "dsh.jev.loopGuard.pLoopThreshold": {
                    "type": "number",
                    "default": 0.6,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%config.jev.loopGuard.pLoopThreshold.description%"
                },
                "dsh.jev.loopGuard.minConfidence": {
                    "type": "number",
                    "default": 0.5,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%config.jev.loopGuard.minConfidence.description%"
                },
                "dsh.jev.loopGuard.cooldownSteps": {
                    "type": "number",
                    "default": 3,
                    "minimum": 1,
                    "maximum": 120,
                    "description": "%config.jev.loopGuard.cooldownSteps.description%"
                },
                "dsh.jev.loopGuard.maxHistory": {
                    "type": "number",
                    "default": 8,
                    "minimum": 1,
                    "maximum": 120,
                    "description": "%config.jev.loopGuard.maxHistory.description%"
                },
                "dsh.jev.loopGuard.deferExactRepeats": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.jev.loopGuard.deferExactRepeats.description%"
                },
                "dsh.jev.loopGuard.requestTimeoutMs": {
                    "type": "number",
                    "default": 3500,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.loopGuard.requestTimeoutMs.description%"
                },
                "dsh.jev.loopGuard.include": {
                    "type": "array",
                    "default": [],
                    "items": { "type": "string", "minLength": 1 },
                    "description": "%config.jev.loopGuard.include.description%"
                },
                "dsh.jev.loopGuard.exclude": {
                    "type": "array",
                    "default": [],
                    "items": { "type": "string", "minLength": 1 },
                    "description": "%config.jev.loopGuard.exclude.description%"
                },
                "dsh.jev.resultShaper.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.jev.resultShaper.enabled.description%"
                },
                "dsh.jev.resultShaper.shapeTools": {
                    "type": "array",
                    "default": ["bash", "pwsh", "terminal", "run_command", "execute_command"],
                    "items": { "type": "string", "minLength": 1 },
                    "description": "%config.jev.resultShaper.shapeTools.description%"
                },
                "dsh.jev.resultShaper.thresholdChars": {
                    "type": "number",
                    "default": 8000,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.resultShaper.thresholdChars.description%"
                },
                "dsh.jev.resultShaper.maxPerTurn": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.resultShaper.maxPerTurn.description%"
                },
                "dsh.jev.resultShaper.keepKinds": {
                    "type": "array",
                    "default": ["warning", "failure"],
                    "items": { "type": "string", "minLength": 1 },
                    "description": "%config.jev.resultShaper.keepKinds.description%"
                },
                "dsh.jev.resultShaper.minKindConfidence": {
                    "type": "number",
                    "default": 0.6,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%config.jev.resultShaper.minKindConfidence.description%"
                },
                "dsh.jev.resultShaper.maxClusters": {
                    "type": "number",
                    "default": 24,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.resultShaper.maxClusters.description%"
                },
                "dsh.jev.resultShaper.sampleChars": {
                    "type": "number",
                    "default": 400,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.resultShaper.sampleChars.description%"
                },
                "dsh.jev.resultShaper.requestTimeoutMs": {
                    "type": "number",
                    "default": 4000,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.resultShaper.requestTimeoutMs.description%"
                },
                "dsh.jev.doneGate.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.jev.doneGate.enabled.description%"
                },
                "dsh.jev.doneGate.blockThreshold": {
                    "type": "number",
                    "default": 0.75,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "%config.jev.doneGate.blockThreshold.description%"
                },
                "dsh.jev.doneGate.minEvidenceItems": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.doneGate.minEvidenceItems.description%"
                },
                "dsh.jev.doneGate.requestTimeoutMs": {
                    "type": "number",
                    "default": 3500,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.doneGate.requestTimeoutMs.description%"
                },
                "dsh.jev.doneGate.maxClaimChars": {
                    "type": "number",
                    "default": 4000,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.doneGate.maxClaimChars.description%"
                },
                "dsh.jev.doneGate.cooldownTurns": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 120000,
                    "description": "%config.jev.doneGate.cooldownTurns.description%"
                },
                "dsh.jev.toolPruner.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.jev.toolPruner.enabled.description%"
                },
                "dsh.jev.toolPruner.maxTools": {
                    "type": "number",
                    "default": 8,
                    "minimum": 1,
                    "maximum": 120,
                    "description": "%config.jev.toolPruner.maxTools.description%"
                },
                "dsh.jev.toolPruner.minScoreThreshold": {
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 2,
