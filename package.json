{
    "name": "dsh-vsc-integration",
    "displayName": "DSH VSCode Integration (Community)",
    "description": "余额快捷显示、内建 Trace，Slash-like Commands、IDE 上下文感知、支持工具卡片与 Reasoning 折叠的 Cline-like 聊天体验。",
    "version": "0.2.2",
    "publisher": "harcochen",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/HarcoChen/dsh-vsc-integration.git"
    },
    "bugs": {
        "url": "https://github.com/HarcoChen/dsh-vsc-integration/issues"
    },
    "homepage": "https://github.com/HarcoChen/dsh-vsc-integration#readme",
    "icon": "resources/dsh.png",
    "engines": {
        "vscode": "^1.106.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": false,
        "untrustedWorkspaces": {
            "supported": false,
            "description": "DSH IDE requires a trusted workspace before it can start an agent runtime."
        }
    },
    "categories": [
        "Other",
        "Chat"
    ],
    "keywords": [
        "DeepSeek",
        "DeepSeek Harness",
        "dsh",
        "agent",
        "AI",
        "chat"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onView:dsh.chatView",
        "onCommand:dsh.open",
        "onCommand:dsh.openTrace",
        "onWebviewPanel:dsh.traceEditor",
        "onCommand:dsh.newSession",
        "onCommand:dsh.switchSession",
        "onCommand:dsh.searchSession",
        "onCommand:dsh.selectModel",
        "onCommand:dsh.renameSession",
        "onCommand:dsh.forkSession",
        "onCommand:dsh.archiveSession",
        "onCommand:dsh.start",
        "onCommand:dsh.stop",
        "onCommand:dsh.restart",
        "onCommand:dsh.insertEditorReference",
        "onCommand:dsh.openIdeContextPicker",
        "onCommand:dsh.configureApiKey",
        "onCommand:dsh.refreshBalance",
        "onCommand:dsh.openLogs",
        "onCommand:dsh.openInBrowser"
    ],
    "contributes": {
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "dsh",
                    "title": "DSH",
                    "icon": "resources/dsh.svg"
                }
            ]
        },
        "views": {
            "dsh": [
                {
                    "type": "webview",
                    "id": "dsh.chatView",
                    "name": "Chat",
                    "icon": "resources/dsh.svg",
                    "visibility": "visible"
                }
            ]
        },
        "commands": [
            {
                "command": "dsh.open",
                "title": "DSH: Open Chat",
                "category": "DSH",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "dsh.openTrace",
                "title": "DSH: Open Session Trace",
                "category": "DSH",
                "icon": "$(pulse)"
            },
            {
                "command": "dsh.newSession",
                "title": "DSH: New Session",
                "category": "DSH",
                "icon": "$(add)"
            },
            {
                "command": "dsh.switchSession",
                "title": "DSH: Switch Session",
                "category": "DSH",
                "icon": "$(list-selection)"
            },
            {
                "command": "dsh.searchSession",
                "title": "DSH: Search Sessions",
                "category": "DSH",
                "icon": "$(search)"
            },
            {
                "command": "dsh.selectModel",
                "title": "DSH: Select Model",
                "category": "DSH",
                "icon": "$(symbol-misc)"
            },
            {
                "command": "dsh.renameSession",
                "title": "DSH: Rename Session",
                "category": "DSH",
                "icon": "$(edit)"
            },
            {
                "command": "dsh.forkSession",
                "title": "DSH: Fork Session",
                "category": "DSH",
                "icon": "$(repo-forked)"
            },
            {
                "command": "dsh.archiveSession",
                "title": "DSH: Archive Session",
                "category": "DSH",
                "icon": "$(archive)"
            },
            {
                "command": "dsh.start",
                "title": "DSH: Start dsh Web Runtime",
                "category": "DSH",
                "icon": "$(play)"
            },
            {
                "command": "dsh.stop",
                "title": "DSH: Stop dsh Web Runtime",
                "category": "DSH",
                "icon": "$(debug-stop)"
            },
            {
                "command": "dsh.restart",
                "title": "DSH: Restart dsh Web Runtime",
                "category": "DSH",
                "icon": "$(refresh)"
            },
            {
                "command": "dsh.openLogs",
                "title": "DSH: Show dsh Runtime Logs",
                "category": "DSH",
                "icon": "$(output)"
            },
            {
                "command": "dsh.openInBrowser",
                "title": "DSH: Open dsh Web UI in Browser",
                "category": "DSH",
                "icon": "$(link-external)"
            },
            {
                "command": "dsh.insertEditorReference",
                "title": "DSH: Insert Current Editor Reference",
                "category": "DSH",
                "icon": "$(references)"
            },
            {
                "command": "dsh.openIdeContextPicker",
                "title": "DSH: Manage IDE Context (/ide)",
                "category": "DSH",
                "icon": "$(settings)"
            },
            {
                "command": "dsh.configureApiKey",
                "title": "DSH: Configure API Key",
                "category": "DSH",
                "icon": "$(key)"
            },
            {
                "command": "dsh.refreshBalance",
                "title": "DSH: Refresh DeepSeek Balance",
                "category": "DSH",
                "icon": "$(dashboard)"
            }
        ],
        "keybindings": [
            {
                "command": "dsh.open",
                "key": "ctrl+shift+alt+d",
                "mac": "cmd+shift+alt+d"
            },
            {
                "command": "dsh.insertEditorReference",
                "key": "alt+k",
                "mac": "alt+k",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "dsh.newSession",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh0"
                },
                {
                    "command": "dsh.switchSession",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh0.1"
                },
                {
                    "command": "dsh.openInBrowser",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh1"
                },
                {
                    "command": "dsh.openTrace",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh0.2"
                },
                {
                    "command": "dsh.openLogs",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh2"
                },
                {
                    "command": "dsh.restart",
                    "when": "view == dsh.chatView",
                    "group": "navigation@dsh3"
                }
            ]
        },
        "configuration": {
            "title": "DSH IDE",
            "properties": {
                "dsh.command": {
                    "type": "string",
                    "default": "npx",
                    "description": "Executable used to start dsh web when dsh.serverUrl is empty. The default uses the official npm entry point; use dsh or an absolute path if the CLI is installed locally. Arguments are configured separately and no shell is used."
                },
                "dsh.commandArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "-y",
                        "@deepseek-ai/dsh",
                        "web"
                    ],
                    "description": "Arguments passed to dsh.command when dsh.serverUrl is empty. The default runs npx -y @deepseek-ai/dsh web. A --port argument is appended when no port is present."
                },
                "dsh.serverUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Optional HTTP(S) URL for an already running, trusted dsh web runtime. When set, the extension attaches to it instead of spawning dsh.command."
                },
                "dsh.serverPort": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 65535,
                    "description": "Port passed to dsh web when dsh.serverUrl is empty and dsh.commandArgs has no port. Zero asks dsh to choose a free port."
                },
                "dsh.autoStart": {
                    "type": "boolean",
                    "default": true,
                    "description": "Start or attach to dsh web automatically when the chat view sends a prompt. If false, start it with a command first."
                },
                "dsh.installWhenMissing": {
                    "type": "boolean",
                    "default": true,
                    "description": "When dsh.command is set to the bare dsh executable and it is missing, try the official @deepseek-ai/dsh package through npx. Other custom commands are never replaced."
                },
                "dsh.startupTimeoutMs": {
                    "type": "number",
                    "default": 30000,
                    "minimum": 1000,
                    "maximum": 120000,
                    "description": "Maximum time to wait for the dsh web HTTP health check after starting or attaching."
                },
                "dsh.requestTimeoutMs": {
                    "type": "number",
                    "default": 600000,
                    "minimum": 10000,
                    "maximum": 3600000,
                    "description": "Maximum time for one Harness RPC, including reconnect history rebaselines. Live assistant output is delivered over WebSocket and is not polled."
                },
                "dsh.maxContextBytes": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 1000,
                    "maximum": 1000000,
                    "description": "Maximum UTF-8 bytes of the assembled <ide_context> block included in one prompt."
                },
                "dsh.persistSession": {
                    "type": "boolean",
                    "default": true,
                    "description": "Reuse the last dsh session ID for the current workspace when possible. Chat messages and attached context are not persisted."
                },
                "dsh.apiKeyEnv": {
                    "type": "string",
                    "default": "DEEPSEEK_API_KEY",
                    "description": "Credential reference passed to dsh.credentials.set when using DSH: Configure API Key. The key is also encrypted in VS Code SecretStorage when balance display is enabled."
                },
                "dsh.balanceRefreshIntervalMs": {
                    "type": "number",
                    "default": 30000,
                    "minimum": 10000,
                    "maximum": 3600000,
                    "description": "Interval for refreshing the DeepSeek balance status bar item."
                }
            }
        }
    },
    "scripts": {
        "build:webview": "node ./scripts/build-webview.mjs",
        "compile": "npm run build:webview && tsc -p ./tsconfig.json",
        "watch": "tsc -watch -p ./tsconfig.json",
        "check": "tsc --noEmit -p ./tsconfig.json",
        "test": "npm run compile && node --test test/*.test.js",
        "package": "npm run compile && vsce package"
    },
    "devDependencies": {
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.3.7",
        "@types/node": "^22.10.2",
        "@types/vscode": "^1.106.0",
        "@vscode/vsce": "^3.6.0",
        "esbuild": "^0.25.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.7.2"
    }
}
